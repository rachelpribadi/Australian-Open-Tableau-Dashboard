      <aliases enabled='yes' />
      <column caption='Tour' datatype='string' name='[Calculation_4352201813827584]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([Table Name], &quot;atp&quot;) THEN &quot;ATP (Men)&quot;&#10;ELSE &quot;WTA (Women)&quot;&#10;END' />
      </column>
      <column caption='Year' datatype='integer' name='[Calculation_4352201813921793]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(LEFT(STR([tourney_date]), 4))' />
      </column>
      <column caption='Is Upset' datatype='integer' name='[Calculation_4352201814007810]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [winner_rank] &gt; [loser_rank] THEN 1 ELSE 0 END' />
      </column>
      <column caption='Break Points Won (Winner)' datatype='integer' name='[Calculation_4352201814114308]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[w_bpFaced] - [w_bpSaved]' />
      </column>
      <column caption='Total Aces' datatype='integer' name='[Calculation_4352201814310917]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[w_ace] + [l_ace]' />
      </column>
      <column caption='Total Points' datatype='integer' name='[Calculation_4352201814360070]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[winner_rank_points] + [loser_rank_points]' />
      </column>
      <column caption='Seed Group' datatype='string' name='[Calculation_4352201814421511]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([winner_seed]) THEN &quot;Unseeded&quot;&#10;ELSEIF [winner_seed] &lt;= 4 THEN &quot;Top 4 Seed&quot;&#10;ELSEIF [winner_seed] &lt;= 8 THEN &quot;Seeds 5–8&quot;&#10;ELSE &quot;Seeds 9+&quot;&#10;END' />
      </column>
      <column caption='Match Label' datatype='string' name='[Calculation_4352201814503432]' role='dimension' type='nominal'>
